# Build context = repo root: `docker build -f infra/docker/Dockerfile.ai .`
FROM python:3.10-slim AS base
RUN apt-get update && apt-get install -y ffmpeg && rm -rf /var/lib/apt/lists/*
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy
WORKDIR /app/apps/ai

# Install deps first (cached) from the lockfile, then the app source.
COPY apps/ai/pyproject.toml apps/ai/uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project
COPY apps/ai/ ./
RUN uv sync --frozen --no-dev

ENV PATH="/app/apps/ai/.venv/bin:$PATH"
EXPOSE 8787
# Apply the AI-plane schema (pgvector + RAG/agent tables) before serving; nothing else
# migrates a deployed database. A failure is logged and the API still starts.
CMD ["sh", "-c", "alembic upgrade head || echo '[migrate] alembic upgrade FAILED - AI tables may be missing'; exec uvicorn app.main:app --host 0.0.0.0 --port 8787"]
